{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    // lib/standalone 的类型声明被 packages/mcp 的编译读取，所以这里要产出声明
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src"]
}
