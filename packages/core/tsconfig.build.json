{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src"],
  // 用例不进发布产物：core 的用例与实现同目录（vitest include: src/**/*.spec.ts），构建要排除它们，
  // 否则 lib/ 里会带上 import vitest 的 .js 与 .d.ts
  "exclude": ["src/**/*.spec.ts"]
}
