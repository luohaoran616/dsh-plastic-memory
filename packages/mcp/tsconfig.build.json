{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src"],
  // 用例、共用助手与测试钩子不进发布产物（与 core 的构建配置同规则）：vitest 的用例与实现同目录
  "exclude": ["src/**/*.spec.ts", "src/spec-helpers.ts", "src/test-hold-lock.ts"]
}
